ArrayList <Cuadrado> tubos;
Pajaro bird;
Cuadrado;
float ultimoPar;
 
 void setup(){
   size(800,600);
   tubos= new ArrayList<Cuadrado>(); 
   bird= new Pajaro(100,height/2);
   ultimoPar = 0;
   
 }
 
 void draw(){
   background(100, 150, 250);
 AgregarTubos();
 borrarTubos();
 for(Cuadrado t: tubos);
 t.mover();
 t.mostrar();
 
 }
 
 bird.mover();
 bird.mostrar();
 
 }
 
 void AgrgarTubos(){
   float tActual=millis;
   float dt= tActual - ultimoPar;
   if(dt > 5000){
     tubos.add(new Cuadrado(width 0, 60, random(150,350), color(30,180,30)));
     tubos.add(new Cuadrado(width,0,60, height-random(150,350), color(30,180,30)));
     ultimoPar = tActual;
   }
 }
 void borrarTubos(){
   for(int i=tubos.size()-1; i>=0; i--){
     Cuadrado aux= tubos.get(i);
     if(aux.x + aux.ancho < 0){
       tubos.remove(i);
     }
   }
 }
 Class Cuadrado{
   float x,y,ancho, alto;
   color color;
   float velX=-2;
   Cuadrado(float x_,float y_,float ancho_,float alto_, color c){
     x=x_;
     y=y_;
     ancho=ancho;
     alto=alto;
     color=c;
   }
   void mover(){
     x+=velX;
   }
   void mostrar(){
     fill(color);
     noStroke();
     rect(x,y,ancho,alto);
   }
 }
 Class Pajaro{
   float x,y, velY;
   float gravedad=0.4;
   color colorPjaro=color(255,200,0);
   Pajaro(float x_,float y_){
     x=x_;
     y=y_;
     velY=0;
   }
   void mover(){
     velY=gravedad;
     y=velY;
     y = constrain(y,20,height - 20);
   }
   void saltar(){
     velY+=-10;
   }
 }
 void keyPressed(){
   bird.saltar();
 }
 
     
 
 
 
